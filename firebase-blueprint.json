{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Store products available in the catalog with barcodes and inventory",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "category": { "type": "string" },
        "categoryLabel": { "type": "string" },
        "price": { "type": "number" },
        "originalPrice": { "type": "number" },
        "barcode": { "type": "string" },
        "stock": { "type": "number" },
        "image": { "type": "string" },
        "description": { "type": "string" },
        "sizes": { "type": "array", "items": { "type": "string" } },
        "colors": { "type": "array", "items": { "type": "string" } },
        "badge": { "type": "string" },
        "inStock": { "type": "boolean" },
        "featured": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "category", "price", "image", "inStock"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer orders submitted via the store",
      "type": "object",
      "properties": {
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "customerCity": { "type": "string" },
        "customerAddress": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "notes": { "type": "string" },
        "items": { "type": "array" },
        "total": { "type": "number" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["customerName", "items", "total", "status"]
    },
    "Sale": {
      "title": "Sale",
      "description": "Completed point-of-sale direct sales transactions",
      "type": "object",
      "properties": {
        "saleCode": { "type": "string" },
        "customerName": { "type": "string" },
        "items": { "type": "array" },
        "totalUSD": { "type": "number" },
        "totalNIO": { "type": "number" },
        "exchangeRate": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "paymentCurrency": { "type": "string" },
        "amountPaid": { "type": "number" },
        "changeGiven": { "type": "number" },
        "notes": { "type": "string" },
        "date": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["saleCode", "items", "totalUSD", "totalNIO", "paymentMethod"]
    },
    "Expense": {
      "title": "Expense",
      "description": "Store operational expenses and inventory purchases",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "category": { "type": "string" },
        "amount": { "type": "number" },
        "currency": { "type": "string" },
        "amountUSD": { "type": "number" },
        "amountNIO": { "type": "number" },
        "date": { "type": "string" },
        "notes": { "type": "string" },
        "receiptUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "category", "amount", "currency", "amountUSD", "amountNIO"]
    },
    "StoreSettings": {
      "title": "StoreSettings",
      "description": "Global store configuration, exchange rate and credentials",
      "type": "object",
      "properties": {
        "whatsAppNumber": { "type": "string" },
        "exchangeRate": { "type": "number" },
        "adminPin": { "type": "string" },
        "announcement": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["whatsAppNumber", "exchangeRate"]
    },
    "CustomRequest": {
      "title": "CustomRequest",
      "description": "Special requests for custom orders or hard-to-find items",
      "type": "object",
      "properties": {
        "customerName": { "type": "string" },
        "customerContact": { "type": "string" },
        "description": { "type": "string" },
        "itemType": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["customerName", "description", "status"]
    }
  },
  "firestore": {
    "products": {
      "entity": "Product",
      "description": "Collection of catalog items"
    },
    "orders": {
      "entity": "Order",
      "description": "Collection of customer orders"
    },
    "sales": {
      "entity": "Sale",
      "description": "Collection of point-of-sale transactions"
    },
    "expenses": {
      "entity": "Expense",
      "description": "Collection of business expenses"
    },
    "store_settings": {
      "entity": "StoreSettings",
      "description": "Store configuration and currency settings"
    },
    "custom_requests": {
      "entity": "CustomRequest",
      "description": "Special orders and inquiries"
    }
  }
}
